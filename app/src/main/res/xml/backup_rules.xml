<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 11 and lower (see data_extraction_rules.xml for 12+).
   Downloaded models (gigabytes) and generated images would blow past the 25 MB backup quota,
   which makes Android skip the app's backup entirely, so they're left out.
-->
<full-backup-content>
    <exclude domain="external" path="Download/image_models/" />
    <exclude domain="external" path="Download/text_models/" />
    <exclude domain="file" path="generated/" />
</full-backup-content>
