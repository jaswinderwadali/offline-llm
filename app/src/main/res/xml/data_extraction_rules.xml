<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 12+. Downloaded models (gigabytes) and generated images would blow past
   the 25 MB cloud backup quota, which makes Android skip the app's backup entirely.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="external" path="Download/image_models/" />
        <exclude domain="external" path="Download/text_models/" />
        <exclude domain="file" path="generated/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="external" path="Download/image_models/" />
        <exclude domain="external" path="Download/text_models/" />
    </device-transfer>
</data-extraction-rules>
